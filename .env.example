# llama.cpp native-builder configuration.
# Copy/edit locally. Boolean values are 0 (off) or 1 (on).

LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_REF=b10270

SOURCE_DIR=.cache/llama.cpp
BUILD_DIR=.build/native
OUTPUT_DIR=output
MODEL_DIR=output/models
ALLOW_EXTERNAL_DIRS=0

# Build orchestration. auto prefers Ninja and all online logical CPUs.
CMAKE_GENERATOR=auto
BUILD_JOBS=auto
CMAKE_C_COMPILER=
CMAKE_CXX_COMPILER=

# Host-only CPU optimization. The binaries can fail with illegal instructions
# on another/older CPU; that non-portability is intentional here.
GGML_NATIVE=1
ENABLE_LTO=1
ENABLE_CCACHE=1
ENABLE_OPENMP=1
ENABLE_CPU_REPACK=1
ENABLE_LLAMAFILE=1

# Keep 0 unless you knowingly accept less conservative floating-point behavior.
ENABLE_FAST_MATH=0

# Optional BLAS acceleration, primarily useful for prompt/batch processing.
ENABLE_BLAS=0
BLAS_VENDOR=OpenBLAS

# NVIDIA CUDA. auto detects only GPUs attached to this host.
ENABLE_CUDA=0
CUDA_ARCHS=auto
ENABLE_CUDA_FA=1
ENABLE_CUDA_FA_ALL_QUANTS=0
ENABLE_CUDA_GRAPHS=1
ENABLE_CUDA_NCCL=0
CUDA_FORCE_MMQ=0
CUDA_FORCE_CUBLAS=0

# AMD ROCm/HIP. auto detects only local gfx targets.
ENABLE_HIP=0
AMDGPU_TARGETS=auto
ENABLE_HIP_GRAPHS=1
ENABLE_HIP_RCCL=0

# Enable at most one primary GPU backend: CUDA/HIP/Vulkan/SYCL/OpenCL.
ENABLE_VULKAN=0
ENABLE_SYCL=0
ENABLE_SYCL_F16=0
SYCL_TARGET=INTEL
SYCL_DEVICE_ARCH=
ENABLE_OPENCL=0

# Additional optional backends/features.
ENABLE_OPENVINO=0
ENABLE_RPC=0
ENABLE_SERVER_UI=0
USE_PREBUILT_UI=0
ENABLE_OPENSSL=0
ENABLE_LLGUIDANCE=0

STRIP_BINARIES=1
OFFLINE=0
SOURCE_UPDATE=0
FORCE_SOURCE_RESET=0
EXTRA_CMAKE_ARGS=
EXTRA_C_FLAGS=
EXTRA_CXX_FLAGS=

# GGUF downloader. The curated menu is optional; any compatible Hugging Face
# GGUF repo can be selected with HF_REPO plus HF_QUANT or HF_FILE.
MODEL=
HF_REPO=
HF_FILE=
HF_QUANT=Q4_K_M
HF_REVISION=main
HF_TOKEN=
HF_API_BASE=https://huggingface.co/api/models
HF_DOWNLOAD_BASE=https://huggingface.co
DOWNLOAD_MMPROJ=0
VERIFY_REMOTE_SHA256=1
STRICT_CHECKSUM=0
STRICT_RESOURCES=0
FORCE_DOWNLOAD=0
DOWNLOAD_RETRIES=4
DOWNLOAD_CONNECT_TIMEOUT=20

# llama-cli / llama-bench defaults.
RUNTIME_THREADS=auto
RUNTIME_THREADS_BATCH=auto
GPU_LAYERS=auto
RUNTIME_DEVICE=
CTX_SIZE=8192

# Rootless persistent llama-server. Nothing is installed or enabled until both
# ENABLE_USER_SERVICE=1 and `make service-enable` are used.
ENABLE_USER_SERVICE=0
SERVICE_NAME=llama-server-native
SERVICE_AUTOSTART=1
SERVICE_START_NOW=1
SERVICE_RESTART=on-failure
SERVICE_RESTART_SEC=3
SERVICE_TIMEOUT_STOP_SEC=90

SERVER_MODEL=qwen3.5-0.8b-q4_k_m
SERVER_MODEL_PATH=
SERVER_ALIAS=local-model
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_THREADS=auto
SERVER_THREADS_BATCH=auto
SERVER_CTX_SIZE=8192
SERVER_PARALLEL=1
SERVER_GPU_LAYERS=auto
SERVER_DEVICE=
SERVER_FLASH_ATTN=auto

# none, mmap, mlock, mmap+mlock, or dio. SERVER_PIN_MODEL=1 forces mmap+mlock.
SERVER_LOAD_MODE=mmap
SERVER_KEEP_MODEL_LOADED=1
SERVER_SLEEP_IDLE_SECONDS=300
SERVER_PIN_MODEL=0
SERVER_FULL_GPU_OFFLOAD=0
SERVER_CACHE_TYPE_K=f16
SERVER_CACHE_TYPE_V=f16
SERVER_CONT_BATCHING=1
SERVER_METRICS=0
SERVER_EMBEDDINGS=0
SERVER_RERANKING=0
SERVER_JINJA=1
SERVER_API_KEY=
SERVER_TIMEOUT=3600
SERVER_EXTRA_ARGS=
